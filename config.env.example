# ===== Meeting Flow 설정 =====
# 이 파일을 config.env 로 복사한 뒤 값을 채우세요.
# cp config.env.example config.env

# --- 경로 ---
MEETINGS_DIR="$HOME/Meetings"                          # 녹음 파일 저장 위치
OBSIDIAN_DIR="$HOME/Documents/ObsidianVault/Meetings"  # 회의록 md가 저장될 vault 폴더

# --- 오디오 ---
# ffmpeg -f avfoundation -list_devices true -i "" 실행 후
# [AVFoundation indev] 목록에서 집계 장치(Aggregate Device)의 인덱스 번호를 입력
AUDIO_DEVICE_INDEX="2"
# 대면(오프라인) 모드에서 쓸 물리 마이크 이름 (위 목록의 이름 그대로).
# 오프라인 모드는 시스템 오디오(BlackHole)가 필요 없는데, Aggregate Device가
# 간헐적으로 BlackHole 서브 디바이스에 IO가 묶여 마이크 신호를 놓치는 문제가 있어
# 오프라인 모드는 이 마이크로 직접 녹음한다. 못 찾으면 AUDIO_DEVICE_INDEX로 폴백.
OFFLINE_MIC_NAME="MacBook Pro Microphone"
# 화상회의 모드에서 전환할 다중 출력 장치 이름 (SwitchAudioSource -a 로 확인)
MULTI_OUTPUT_DEVICE="Multi-Output Device"
# 평소 사용하는 출력 장치 이름 (회의 종료 후 복원용, 비워두면 복원 생략)
DEFAULT_OUTPUT_DEVICE="MacBook Pro Speakers"

# --- macOS 집중 모드 (단축어 연동) ---
# 단축어 앱에 만든 집중 모드 켜기/끄기 단축어 이름 (비워두면 건너뜀)
# 켜기: "집중 모드 설정 > 방해금지 > 끌 때까지 켜기" 동작으로 생성
FOCUS_SHORTCUT_ON=""
FOCUS_SHORTCUT_OFF=""

# --- Slack ---
# https://api.slack.com/apps 에서 앱 생성 → User Token Scopes:
#   dnd:write, users.profile:write  → Install to Workspace → xoxp- 토큰 복사
SLACK_USER_TOKEN="xoxp-..."
SLACK_DND_MINUTES="180"

# --- 캘린더 (icalBuddy) ---
# Mac 캘린더 앱에 표시되는 캘린더 이름 (icalBuddy calendars 로 확인)
CALENDAR_NAME="your.name@company.com"

# --- NCP Object Storage ---
NCP_ACCESS_KEY=""
NCP_SECRET_KEY=""
NCP_BUCKET=""                                          # CLOVA Speech 도메인에 연동한 버킷
NCP_OS_ENDPOINT="https://kr.object.ncloudstorage.com"

# --- CLOVA Speech (장문 인식 도메인) ---
# 콘솔 > CLOVA Speech > 도메인 상세에서 확인
CLOVA_INVOKE_URL="https://clovaspeech-gw.ncloud.com/external/v1/....."
CLOVA_SECRET_KEY=""

# --- 요약 템플릿 ---
# 회의 제목 키워드 → templates/<이름>.md 매핑 ("키워드:이름" 쉼표 구분)
# 제목에 키워드가 포함되면(대소문자 무시) 해당 템플릿, 없으면 templates/default.md
TEMPLATE_RULES="STR Weekly:str-weekly,AX Champion Weekly:ax-champion-weekly,[AX] 1-on-1:ax-1on1"

# --- Obsidian 프로젝트 연결 ---
# 프로젝트 노트 폴더 (하위 폴더 포함, 비워두면 연결 기능 끔)
PROJECTS_DIR="$HOME/Documents/ObsidianVault/Projects"
# 프로젝트를 부르는 다른 이름들 ("별칭:노트명" 쉼표 구분, LLM 매칭 힌트)
PROJECT_ALIASES=""

# --- Claude API (요약용) ---
ANTHROPIC_API_KEY=""
